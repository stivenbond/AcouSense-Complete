# ── Express auth server ─────────────────────────────────────────────────────
# Required in production. In demo mode (DEMO_MODE=true) a development-only
# fallback secret is used so the server starts with no configuration.
JWT_SECRET=replace_with_a_long_random_secret

# SQLite path (or Postgres URL in production — currently only SQLite is wired
# in this reference implementation).
DATABASE_URL=./acousense.db

# Express port (3001 is often used by EnterpriseDB Postgres on Windows)
PORT=3030

# When true: console-log password reset links instead of sending email,
# and accept HTTP cookies (no Secure flag) for localhost development.
DEMO_MODE=true

# CORS origin allowed to talk to the auth API with credentials.
VITE_APP_URL=http://localhost:5173

# ── SMTP (production only) ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@acousense.app
