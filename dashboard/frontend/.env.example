# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ── DSP backend (acousense FastAPI) ──────────────────────────────────────────
# URL the Vite dev server will proxy /api, /health, /ready to.
# The backend is started via:  uvicorn acousense.api.main:app --port 8000
VITE_BACKEND_URL="http://localhost:8000"

# Production-only: absolute base URL for direct requests (no dev proxy).
# Leave blank in dev so the proxy handles routing.
VITE_API_BASE_URL=""

# Set to "true" to make sensorApi.ts call the FastAPI backend instead of the
# Supabase "sensor-data" Edge Function.
VITE_USE_BACKEND="false"

# ── Express auth server (auth-server/index.js) ───────────────────────────────
# Started automatically by `npm run dev`. The Vite proxy forwards /api/auth/*
# requests here so the session cookie is same-origin and works without CORS.
VITE_AUTH_URL="http://localhost:3030"

# ── MapTiler (optional, free tier) ───────────────────────────────────────────
# Required for the "Terrain" map style. Without it the app falls back to
# OpenTopoMap raster tiles. Get a key at https://www.maptiler.com/cloud/
VITE_MAPTILER_KEY=""

# ── Web Push VAPID public key (optional) ─────────────────────────────────────
# Required for real (non-demo) browser push subscriptions.
VITE_VAPID_PUBLIC_KEY=""
