# ── AcouSense auth server ───────────────────────────────────────────────────
# URL of the Express auth server (auth-server/index.js).
VITE_API_URL=http://localhost:3030

# Public origin of this SvelteKit frontend (used by the auth server's CORS
# allow-list and by the password-reset link in emails).
VITE_APP_URL=http://localhost:5173

# ── Existing AcouSense back-end ─────────────────────────────────────────────
PUBLIC_FLASK_URL=/flask
PUBLIC_POLL_MS=5000
PUBLIC_DEMO_MODE=true

# Docker web UI target. Use the ESP32 IP printed in the serial monitor after
# Wi-Fi connects, for example http://192.168.1.42. The AP fallback/default is
# http://192.168.4.1.
PUBLIC_ESP_API_ORIGIN=http://192.168.4.1
PUBLIC_AUTH_ORIGIN=
WEBUI_PORT=8080
